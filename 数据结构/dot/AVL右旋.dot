digraph {
    rankdir=TB
    margin="0.3,0.3"
    bgcolor="#ffffff"
    node [shape=circle, width=0.4, height=0.4, fixedsize=true, fontname="Microsoft YaHei", fontsize=11]
    edge [arrowsize=0.6]

    subgraph cluster_before {
        label="旋转前: BF(Z)=2"; style=dashed; color="#dc2626"; fontname="Microsoft YaHei"; fontsize=12
        node [style=filled, fillcolor="#fee2e2", color="#dc2626"]
        Z; Y; X; T1; T2; T3; T4
        Z->Y; Z->T4; Y->X; Y->T3; X->T1; X->T2
    }
    subgraph cluster_after {
        label="旋转后"; style=dashed; color="#16a34a"; fontname="Microsoft YaHei"; fontsize=12
        node [style=filled, fillcolor="#dcfce7", color="#16a34a"]
        Y2[label=Y]; X2[label=X]; Z2[label=Z]; T1_2; T2_2; T3_2; T4_2
        Y2->X2; Y2->T3_2; Y2->Z2
        X2->T1_2; X2->T2_2
        Z2->T4_2
    }
}
